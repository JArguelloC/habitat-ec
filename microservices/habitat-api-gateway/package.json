{
  "name": "habitat-api-gateway",
  "version": "2.2.0",
  "description": "API Gateway / ESB Orquestador Perimetral para Hábitat EC (NODE_ALO_HAB) - Enrutamiento REST (/api/v1, /api/v2), GraphQL (/graphql), gRPC Client y SOA",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  }
}

