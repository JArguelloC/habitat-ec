# ==============================================================================
# HÁBITAT EC - PLANTILLA DE VARIABLES DE ENTORNO FRONTEND SPA (SIN SECRETOS)
# Copiar a frontend/.env y completar con tus valores públicos
# ==============================================================================

VITE_API_URL=http://localhost:3000/api/v1
VITE_GOOGLE_CLIENT_ID=<your_google_oauth_client_id>.apps.googleusercontent.com

# ==============================================================================
# CLOUDINARY UPLOAD WIDGET (SUBIDA DIRECTA NO FIRMADA / UNSIGNED)
# ==============================================================================
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned
