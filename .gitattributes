# Normalización automática de saltos de línea (Windows CRLF -> Linux LF)
* text=auto eol=lf

# Archivos de código fuente y configuración
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary

