PORT=3000

# Conexión principal PostgreSQL (URI)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Variables atómicas de conexión directa (Neon Serverless)
DB_HOST=ep-example.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=your_password_here
DB_NAME=neondb

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_example
JWT_EXPIRES_IN=7d
