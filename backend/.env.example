# ==============================================================================
# HÁBITAT EC - PLANTILLA DE VARIABLES DE ENTORNO BACKEND (SIN SECRETOS)
# Copiar a backend/.env y completar con tus credenciales privadas
# ==============================================================================

PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL 16 (Neon Serverless + PostGIS + btree_gist)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# Seguridad JWT & OAuth 2.0
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>.apps.googleusercontent.com

# Pasarelas de Pago Adquirentes (Opcional: si se omiten, opera en Modo Sandbox Certificado)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
STRIPE_SECRET_KEY=
